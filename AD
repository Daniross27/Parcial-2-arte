#include <WiFi.h> // Agregado para ESP32
#include "Adafruit_MQTT.h"
#include "Adafruit_MQTT_Client.h"

// ---------------------- 1. CREDENCIALES WI-FI Y ADAFRUIT IO ----------------------
#define WLAN_SSID "ARTEFACTOS"
#define WLAN_PASS "ARTEFACTOS"
#define AIO_SERVER "io.adafruit.com"
#define AIO_SERVERPORT 1883
#define AIO_USERNAME "TU_USUARIO_ADAFRUIT" 
#define AIO_KEY "TU_AIO_KEY" // Key activa de tu cuenta de Adafruit IO

// ---------------------- 2. PINES DE LOS SENSORES ----------------------
#define TRIG_PIN 18
#define ECHO_PIN 19
#define PIN_LDR 32

// ---------------------- 3. CONFIGURACIÓN DE PUBLICACIÓN ----------------------
#define INTERVALO_PUBLICAR_MS 5000 // Publicar cada 5 s para respetar el límite de Adafruit IO
unsigned long ultimoPublicar = 0;
unsigned long ultimoPing = 0;

// ---------------------- 4. CLIENTE MQTT Y FEEDS DE PUBLICACIÓN ----------------------
WiFiClient client;
Adafruit_MQTT_Client mqtt(&client, AIO_SERVER, AIO_SERVERPORT, AIO_USERNAME, AIO_KEY);

// Se crea un objeto Adafruit_MQTT_Publish por cada Feed configurado en la web
Adafruit_MQTT_Publish feedDistancia = Adafruit_MQTT_Publish(&mqtt, AIO_USERNAME "/feeds/distancia");
Adafruit_MQTT_Publish feedLuz = Adafruit_MQTT_Publish(&mqtt, AIO_USERNAME "/feeds/luz");

// PROTOTIPOS DE FUNCIÓN
void conectarWiFi();
void conectarMQTT();
float leerDistanciaCm();

void setup()
{
    Serial.begin(115200);
    pinMode(TRIG_PIN, OUTPUT);
    pinMode(ECHO_PIN, INPUT);
    pinMode(PIN_LDR, INPUT);
    conectarWiFi();
}

void loop()
{
    conectarMQTT(); // Mantiene la sesión activa con Adafruit IO

    // Enviar las mediciones cada 5 segundos de forma no bloqueante
    if (millis() - ultimoPublicar >= INTERVALO_PUBLICAR_MS)
    {
        ultimoPublicar = millis();

        // 1. Obtener lecturas de los sensores
        float distancia = leerDistanciaCm();
        int ldrRaw = analogRead(PIN_LDR);
        int luzPorcentaje = (ldrRaw * 100) / 4095; // Escalado ADC de 12 bits

        // 2. Publicar a sus respectivos Feeds en Adafruit IO
        if (distancia > 0)
        {
            Serial.print("Publicando Distancia: ");
            Serial.print(distancia);
            Serial.println(" cm");
            feedDistancia.publish(distancia); // Envía el valor al feed "distancia"
        }

        Serial.print("Publicando Luz: ");
        Serial.print(luzPorcentaje);
        Serial.println(" %");
        feedLuz.publish(luzPorcentaje); // Envía el valor al feed "luz"
    }

    // Mantener vivo el canal MQTT (Ping cada 30 segundos)
    if (millis() - ultimoPing >= 30000)
    {
        ultimoPing = millis();
        mqtt.ping();
    }
}

// ---------------------- FUNCIONES AUXILIARES ----------------------
float leerDistanciaCm()
{
    digitalWrite(TRIG_PIN, LOW);
    delayMicroseconds(2);
    digitalWrite(TRIG_PIN, HIGH);
    delayMicroseconds(10);
    digitalWrite(TRIG_PIN, LOW);

    long duracion = pulseIn(ECHO_PIN, HIGH, 30000);
    if (duracion == 0)
        return -1;

    float d = (duracion * 0.0343) / 2.0;
    if (d < 2 || d > 400)
        return -1;
    return d;
}

void conectarWiFi()
{
    Serial.print("Conectando a Wi-Fi...");
    WiFi.begin(WLAN_SSID, WLAN_PASS);
    while (WiFi.status() != WL_CONNECTED)
    {
        delay(500);
        Serial.print(".");
    }
    Serial.println("\nWi-Fi Conectado. IP: " + WiFi.localIP().toString());
}

void conectarMQTT()
{
    if (mqtt.connected())
        return;

    Serial.print("Conectando con Adafruit IO...");
    int8_t ret;
    uint8_t intentos = 3;

    while ((ret = mqtt.connect()) != 0)
    {
        Serial.println(mqtt.connectErrorString(ret));
        Serial.println("Reintentando en 5 segundos...");
        mqtt.disconnect();
        delay(5000);
        if (--intentos == 0)
        {
            Serial.println("Fallo de conexión. Reiniciando ESP32...");
            ESP.restart();
        }
    }
    Serial.println(" ¡Conectado exitosamente con Adafruit IO!");
}
